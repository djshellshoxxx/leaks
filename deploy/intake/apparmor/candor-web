# AppArmor profile for C-06 candor-web (17 §5.2; R7 SI-B-04). Enforce mode.
# Installed as /etc/apparmor.d/candor-web; attached by AppArmorProfile=candor-web in
# candor-intake-web.service (the unit fails to start if the profile is not loaded).
# Allowed: read program, templates/static assets and the signed config bundle; accept on the
# inherited http listener; connect to the sealer and intake-store sockets. Nothing else:
# no IP networking, no writes anywhere, no exec, no capabilities.
abi <abi/3.0>,
# Self-contained (AUD-RM2-DEP-23): no include of distribution abstractions or tunables (their
# drop-in directories could widen this profile). The two variables are defined here (values of
# Debian's tunables/proc and tunables/kernelvars); the runtime rules are inlined below.
@{PROC}=/proc/
@{pid}={[1-9],[1-9][0-9],[1-9][0-9][0-9],[1-9][0-9][0-9][0-9],[1-9][0-9][0-9][0-9][0-9],[1-9][0-9][0-9][0-9][0-9][0-9],[1-4][0-9][0-9][0-9][0-9][0-9][0-9]}

profile candor-web /usr/lib/candor/source-web/candor-web {
  # ---- runtime, inlined and minimised from abstractions/base (AUD-RM2-DEP-23): dynamic loader
  # and shared libraries (read/map, no write, no exec of anything else), /dev/null for the
  # inherited stdio, /dev/urandom, the own memory map (glibc/Rust main-thread stack guard) and
  # signals between the process's own threads/processes. Not inlined: locale, X11, home
  # directories, ld.so.preload, journal sockets, ptrace, the other base rules.
  /etc/ld.so.cache r,
  /usr/lib/*-linux-gnu*/**.so* mr,
  /dev/null rw,
  /dev/urandom r,
  @{PROC}/@{pid}/maps r,
  signal (send, receive) peer=@{profile_name},

  /usr/lib/candor/source-web/candor-web mr,
  /usr/share/candor/web/ r,
  /usr/share/candor/web/** r,
  /run/candor/config/ r,
  /run/candor/config/** r,

  # Inherited AF_UNIX stream listener "http" (from tor), and the client stream to the sealer
  # (seal.sock is SOCK_STREAM with length-prefixed frames; sealer SPEC-NOTES item 9).
  network unix stream,
  unix (create, connect, accept, receive, send, getattr, getopt, setopt, shutdown) type=stream,
  # Client of the intake store (07 §5.3), SOCK_SEQPACKET.
  network unix seqpacket,
  unix (create, connect, receive, send, getattr, getopt, setopt, shutdown) type=seqpacket,
  /run/candor/sealer/seal.sock rw,
  /run/candor/istore/istore.sock rw,

  # Rust std runtime: available_parallelism() reads the cgroup CPU quota.
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  /sys/fs/cgroup/**/cpu.max r,
  /sys/devices/system/cpu/online r,
  # Signals from systemd only.
  signal (receive) peer=unconfined,

  # ---- explicit denials (win over any allow; denials are audited) ----
  deny capability,
  deny ptrace,
  deny mount,
  deny umount,
  deny pivot_root,
  deny network inet6,
  deny network netlink,
  deny network packet,
  deny @{PROC}/*/mem rw,
  deny @{PROC}/*/environ r,
  deny @{PROC}/kcore r,
  deny /dev/mem rw,
  deny /dev/kmem rw,
  # No syslog path: output only via the inherited stderr stream (typed candor-log, ADR-016).
  deny /dev/log w,
  deny /run/systemd/journal/dev-log w,
  deny /run/systemd/journal/socket w,
  deny /run/systemd/journal/syslog w,
  deny /run/tor-instances/** rwklx,
  deny /var/lib/tor-instances/** rwklx,
  deny /var/lib/postgresql/** rwklx,
  deny /etc/credstore.encrypted/** rwklx,
  deny /etc/tor/** rwklx,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /boot/** rwklx,
  deny network inet,
  deny /var/lib/candor/** rwklx,
  deny /run/candor/staging/** rwklx,
  deny /run/candor/directory/** rwklx,
  deny /run/credentials/** rwklx,
}
