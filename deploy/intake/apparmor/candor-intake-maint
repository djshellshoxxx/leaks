# AppArmor profile for the intake maintenance jobs (candor-intake-vacuum.service,
# candor-intake-maint.service; AUD-RM2-STO-11/23/24). Enforce mode. Installed as
# /etc/apparmor.d/candor-intake-maint; attached by AppArmorProfile=candor-intake-maint.
# Allowed: read program and the signed config bundle (Z-CORE head key); the PostgreSQL socket.
# Denied: every write, exec, capabilities, all IP networking, any blob/staging/tor/sealer state.
abi <abi/3.0>,

# Self-contained (AUD-RM2-DEP-23): no include of distribution abstractions or tunables (their
# drop-in directories could widen this profile). The two variables are defined here (values of
# Debian's tunables/proc and tunables/kernelvars); the runtime rules are inlined below.
@{PROC}=/proc/
@{pid}={[1-9],[1-9][0-9],[1-9][0-9][0-9],[1-9][0-9][0-9][0-9],[1-9][0-9][0-9][0-9][0-9],[1-9][0-9][0-9][0-9][0-9][0-9],[1-4][0-9][0-9][0-9][0-9][0-9][0-9]}

profile candor-intake-maint /usr/lib/candor/intake-store/candor-intake-maint {
  # ---- runtime, inlined and minimised from abstractions/base (AUD-RM2-DEP-23): dynamic loader
  # and shared libraries (read/map, no write, no exec of anything else), /dev/null for the
  # inherited stdio, /dev/urandom, the own memory map (glibc/Rust main-thread stack guard) and
  # signals between the process's own threads/processes. Not inlined: locale, X11, home
  # directories, ld.so.preload, journal sockets, ptrace, the other base rules.
  /etc/ld.so.cache r,
  /usr/lib/*-linux-gnu*/**.so* mr,
  /dev/null rw,
  /dev/urandom r,
  @{PROC}/@{pid}/maps r,
  signal (send, receive) peer=@{profile_name},

  /usr/lib/candor/intake-store/candor-intake-maint mr,
  /run/candor/config/ r,
  /run/candor/config/** r,

  # PostgreSQL client over the Unix socket only (peer authentication as candor_intake_maint,
  # the database owner; no SET ROLE).
  network unix stream,
  unix (create, connect, receive, send, getattr, getopt, setopt, shutdown) type=stream,
  /run/candor/intake-pg/.s.PGSQL.5432 rw,

  # Rust std runtime: available_parallelism() reads the cgroup CPU quota.
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  /sys/fs/cgroup/**/cpu.max r,
  /sys/devices/system/cpu/online r,

  signal (receive) peer=unconfined,

  deny capability,
  deny ptrace,
  deny mount,
  deny umount,
  deny pivot_root,
  deny network inet,
  deny network inet6,
  deny network netlink,
  deny network packet,
  deny @{PROC}/*/mem rw,
  deny @{PROC}/*/environ r,
  deny @{PROC}/kcore r,
  deny /dev/mem rw,
  deny /dev/kmem rw,
  deny /dev/log w,
  deny /run/systemd/journal/dev-log w,
  deny /run/systemd/journal/socket w,
  deny /run/systemd/journal/syslog w,
  deny /run/tor-instances/** rwklx,
  deny /var/lib/tor-instances/** rwklx,
  deny /var/lib/postgresql/** rwklx,
  deny /var/lib/candor/** rwklx,
  deny /run/candor/source-web/** rwklx,
  deny /run/candor/sealer/** rwklx,
  deny /run/candor/istore/** rwklx,
  deny /run/candor/staging/** rwklx,
  deny /run/candor/directory/** rwklx,
  deny /run/credentials/** rwklx,
  deny /etc/credstore.encrypted/** rwklx,
  deny /etc/tor/** rwklx,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /boot/** rwklx,
}
