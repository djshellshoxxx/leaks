# SPDX-License-Identifier: AGPL-3.0-or-later
# C-07 sealer IPC (07 §5.2: AF_UNIX SOCK_SEQPACKET; peer = candor-web, checked again in the
# sealer with SO_PEERCRED). Directory 0750 candor-sealer:candor-web (tmpfiles.d).
[Unit]
Description=Candor sealer IPC socket (C-07, Z-INTAKE)
After=systemd-tmpfiles-setup.service

[Socket]
ListenSequentialPacket=/run/candor/sealer/seal.sock
SocketUser=candor-sealer
SocketGroup=candor-web
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Backlog=64
FileDescriptorName=seal
Service=candor-sealer.service

[Install]
WantedBy=sockets.target
