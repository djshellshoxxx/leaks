# Slot-scheduled VACUUM of the intake tables (AUD-RM2-STO-11/23; lead disposition 2026-10-01).
# The intake cluster runs with autovacuum = off and track_counts = off, so no vacuum ever runs
# at a time chosen by source activity: dead tuples left by the import slot's uniform rewrite are
# vacuumed at a fixed offset after every import slot, by the maintenance login, whatever
# happened. Contract for the binary (deploy/SPEC-NOTES.md D-34): `candor-intake-maint vacuum`
# runs plain VACUUM on the intake tables of every tenant database and exits; it opens no other
# connection and writes nothing but PostgreSQL pages.
[Unit]
Description=Candor intake slot VACUUM (C-08, fixed schedule)
Requires=candor-intake-pg.service nftables.service
After=candor-intake-pg.service nftables.service
# Started only by its timer; never pulled in at boot (no [Install] section).

[Service]
Type=oneshot
ExecStart=/usr/lib/candor/intake-store/candor-intake-maint vacuum
# Maintenance login (09 §10 Roles; AUD-RM2-STO-24): OS user candor-imaint, peer-mapped to the DB
# role candor_intake_maint only (pg_hba/pg_ident). PostgreSQL socket via its group.
User=candor-imaint
Group=candor-imaint
SupplementaryGroups=candor-istore
AppArmorProfile=candor-intake-maint
TimeoutStartSec=30min
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
# ---- 07 §4.2 / 17 §5.3 / R7 SI-B-01 hardening baseline (do not weaken; config-check.sh) ----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
LimitCORE=0
NoExecPaths=/
ExecPaths=/usr
IPAddressDeny=any
SocketBindDeny=any
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module @clock @setuid @chown @keyring process_vm_readv process_vm_writev
SystemCallFilter=seccomp landlock_create_ruleset landlock_add_rule landlock_restrict_self
# Nothing on Z-INTAKE is visible except the PostgreSQL socket and the public config bundle.
TemporaryFileSystem=/var:ro
InaccessiblePaths=-/var/tmp
InaccessiblePaths=-/run/tor-instances -/run/candor/source-web -/run/candor/sealer -/run/candor/istore -/run/candor/staging -/run/candor/directory -/run/credentials -/etc/credstore.encrypted -/etc/tor -/etc/candor/intake/postgresql -/boot
# ---- Logging (ADR-053(2), D-28): no output in any journal ----
StandardInput=null
StandardOutput=null
StandardError=null
LogNamespace=candor-intake
LogLevelMax=emerg
SyslogIdentifier=candor-intake-vacuum
